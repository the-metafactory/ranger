#!/usr/bin/env bash
# Fake `gh` for tests. Introspection + per-repo read.
# Args: api <path> [-i] [--jq <expr>]
set -euo pipefail

if [ -z "${GH_TOKEN:-}" ]; then
  echo "fake gh: GH_TOKEN not set" >&2
  exit 95
fi

path="${2:-}"
# Every request is logged when the test asks, so a test can assert that a
# throttled token makes no GitHub call at all (src/budget.ts).
if [ -n "${FAKE_GH_CALLS:-}" ]; then
  printf "%s\n" "$path" >> "$FAKE_GH_CALLS"
fi
case "$path" in
  repos/*/pulls*|repos/*/commits/*/check-runs\?*)
    exec bun "$(dirname "$0")/research-gh.ts" "$path" "${@:3}"
    ;;
  /user)
    # login depends on the credential: write token → machine account, a
    # principal-token sentinel → the principal, else the read account.
    login="scout-test"
    if [ "${GH_TOKEN:-}" = "ghp_write" ]; then
      login="ivy-bot"
    fi
    if [ "${GH_TOKEN:-}" = "ghp_principal" ]; then
      login="jcfischer"
    fi
    if [ "${3:-}" = "-i" ]; then
      scopes="${GH_SCOPES:-}"
      cat <<EOF
HTTP/2.0 200 OK
content-type: application/json; charset=utf-8
x-oauth-scopes: ${scopes}
x-github-request-id: fake

{"login":"${login}","id":1,"type":"User"}
EOF
      exit 0
    fi
    if [ "${3:-}" = "--jq" ] && [ "${4:-}" = ".login" ]; then
      echo "${login}"
      exit 0
    fi
    ;;
  rate_limit)
    # GET /rate_limit, already narrowed to .resources.graphql by the caller.
    reset=$(( $(date +%s) + 3600 ))
    echo "{\"limit\":5000,\"remaining\":${FAKE_GH_GRAPHQL_REMAINING:-5000},\"reset\":${reset},\"used\":0}"
    exit 0
    ;;
  repos/*/issues/events\?*)
    # The frontier cache's sentinel, second half: the newest issue-event id.
    [ -n "${FAKE_GH_SENTINEL_FAIL:-}" ] && { echo "fake gh: sentinel down" >&2; exit 1; }
    # Default: a checksum of the fake graph, so a test that rewrites its
    # fixtures has "changed the repo" exactly as a real edit moves GitHub's
    # sentinel — and the frontier cache re-reads.
    if [ -n "${FAKE_GH_EVENTS_LATEST:-}" ]; then
      echo "$FAKE_GH_EVENTS_LATEST"
    elif [ -n "${FAKE_SOMA_DIR:-}" ]; then
      cat "$FAKE_SOMA_DIR"/*.json 2>/dev/null | cksum | cut -d' ' -f1
    else
      echo 1000
    fi
    exit 0
    ;;
  repos/*/issues\?*)
    # The frontier cache's sentinel, first half: the newest issue updated_at.
    [ -n "${FAKE_GH_SENTINEL_FAIL:-}" ] && { echo "fake gh: sentinel down" >&2; exit 1; }
    echo "${FAKE_GH_ISSUES_UPDATED:-2026-01-01T00:00:00Z}"
    exit 0
    ;;
  repos/*)
    if [ "${3:-}" = "--jq" ] && [ "${4:-}" = ".full_name" ]; then
      echo "${path#repos/}"
      exit 0
    fi
    ;;
esac

echo "fake gh: unhandled request path='$path' args=$*" >&2
exit 96
