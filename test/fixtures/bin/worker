#!/usr/bin/env bash
# Fake ranger research worker for tests. Receives the assembled prompt as $1.
# Performs the research SOP in the worktree: the supervisor has already
# checked out the throwaway research/api-survey branch (the declared
# git-ref-exists probe ref) with --no-track; write findings.md, commit
# LOCALLY — NO push: the worker never holds the write PAT (round-38 security
# blocker); the SUPERVISOR performs the vetted push.
set -euo pipefail

# Security guard (round-38): the worker must NEVER see the write PAT — the
# supervisor performs the vetted push. Fail hard if it leaks into the env.
if [ -n "${GIT_CONFIG_VALUE_0:-}" ]; then
  echo "worker env leaked the write PAT — refusing to run" >&2
  exit 3
fi

# Node #66: the supervisor hands every worker session its own temp journal,
# never the live one. Fail hard if it is missing.
case "${RANGER_JOURNAL_PATH:-}" in
  "" | "$HOME/.config/ranger/"*)
    echo "worker env has no per-session journal (RANGER_JOURNAL_PATH=${RANGER_JOURNAL_PATH:-unset}) — refusing to run" >&2
    exit 4
    ;;
esac

cd "$(git rev-parse --show-toplevel)"
# The research branch is the supervisor's to create (no tracking lines in the
# shared config); a worker that finds any other branch checked out fails.
current="$(git branch --show-current)"
if [ "$current" != "research/api-survey" ]; then
  echo "expected the supervisor to check out research/api-survey, found '$current'" >&2
  exit 5
fi
cat > findings.md <<'EOF'
# Research findings: api-survey

Surveyed the third-party API (e2e fake worker).

- Endpoint catalog: 3 resources
- Auth model: OAuth2 client credentials
- Rate limits: 1000 req/h

Recommendation: adopt the API; the auth model fits the existing stack.
EOF
git add findings.md
git commit -m "research findings: api-survey"
echo "fake worker done; prompt bytes: ${#1}"
