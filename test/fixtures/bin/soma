#!/usr/bin/env bash
# Fake `soma` for tests.
#
# Reads (frontier/audit/node) come from fixture JSON in $FAKE_SOMA_DIR. Mutations
# (claim/release/close/decisions) are stateful against $FAKE_SOMA_STATE (JSON),
# and `close` verifies git-ref-exists probes against the real git repo at
# $FAKE_SOMA_REPO_DIR (a bare origin, so a pushed branch shows up directly).
set -euo pipefail

# A GitHub repo reads and writes under GH_TOKEN; a GitLab repo under the
# per-call glab config ranger writes (GLAB_CONFIG_DIR). Either way, no keyring.
if [ -z "${GH_TOKEN:-}" ] && [ -z "${GLAB_CONFIG_DIR:-}" ]; then
  echo "fake soma: GH_TOKEN not set — refusing (no keyring fallback)" >&2
  exit 90
fi
if [ -z "${FAKE_SOMA_DIR:-}" ]; then
  echo "fake soma: FAKE_SOMA_DIR not set" >&2
  exit 91
fi

verb="${2:-}"
root="${3:-}"
repo=""
json_flag=""
identity=""
resolution_file=""
gist=""
checkpoint=""
ci=""
propose=""
body_file=""
proposal_comment=""
title=""
autonomy=""
body=""
parent=""
labels=""
kind=""
probes=""
evidence_file="$(mktemp)"
i=4
while [ $i -le $# ]; do
  arg="${!i}"
  case "$arg" in
    --repo) i=$((i+1)); repo="${!i}" ;;
    --json) json_flag=1 ;;
    --identity) i=$((i+1)); identity="${!i}" ;;
    --resolution-file) i=$((i+1)); resolution_file="${!i}" ;;
    --gist) i=$((i+1)); gist="${!i}" ;;
    --checkpoint) i=$((i+1)); checkpoint="${!i}" ;;
    --ci) i=$((i+1)); ci="${!i}" ;;
    --propose) propose=1 ;;
    --body-file) i=$((i+1)); body_file="${!i}" ;;
    --proposal-comment) i=$((i+1)); proposal_comment="${!i}" ;;
    --evidence) i=$((i+1)); printf "%s\n" "${!i}" >> "$evidence_file" ;;
    --title) i=$((i+1)); title="${!i}" ;;
    --autonomy) i=$((i+1)); autonomy="${!i}" ;;
    --body) i=$((i+1)); body="${!i}" ;;
    --parent) i=$((i+1)); parent="${!i}" ;;
    --label) i=$((i+1)); labels="${labels}${!i}"$'\n' ;;
    --kind) i=$((i+1)); kind="${!i}" ;;
    --probe) i=$((i+1)); probes="${probes}${!i}"$'\n' ;;
    --write) : ;;
    --dry-run) : ;;
  esac
  i=$((i+1))
done

# Real soma resolves a bare owner/name only from a checkout with an origin
# remote, and launchd runs ranger from `/` (2026-09-25 outage). The fake is
# stricter than soma: it refuses a bare repo wherever it runs, so a call site
# that forgets to qualify fails here instead of only in production.
case "$repo" in
  github:github.com/*)
    if [ -z "${GH_TOKEN:-}" ]; then
      echo "fake soma: GH_TOKEN not set — refusing (no keyring fallback)" >&2
      exit 90
    fi
    repo="${repo#github:github.com/}"
    ;;
  # A GitLab repo keeps its host: its fixtures are <host>__<group>__<project>-*.json.
  gitlab:*)
    if [ -z "${GLAB_CONFIG_DIR:-}" ]; then
      echo "fake soma: GLAB_CONFIG_DIR not set — refusing (no keyring fallback)" >&2
      exit 90
    fi
    repo="${repo#gitlab:}"
    ;;
  "") ;;
  *)
    echo "fake soma: \"$repo\" names no forge or host — pass --repo github:github.com/<owner/name>" >&2
    exit 2
    ;;
esac
# Every invocation is logged (verb + bare repo) when the test asks, so a test
# can count graph reads — the cache (src/frontier-cache.ts) is judged by it.
if [ -n "${FAKE_SOMA_CALLS:-}" ]; then
  printf "%s %s\n" "$verb" "$repo" >> "$FAKE_SOMA_CALLS"
fi
# A test can make the read verbs fail as GitHub's throttle does.
if [ -n "${FAKE_SOMA_RATE_LIMITED:-}" ]; then
  case "$verb" in
    frontier|audit|node)
      echo "gh api POST graphql failed (exit 1): gh: API rate limit already exceeded for user ID 1." >&2
      exit 1
      ;;
  esac
fi

# A test can make the audit alone fail, as a soma error or timeout does (node #154).
if [ "$verb" = "audit" ] && [ -n "${FAKE_SOMA_AUDIT_FAIL:-}" ]; then
  echo "fake soma: audit failed" >&2
  exit 1
fi

if [ -n "${FAKE_SOMA_ROOT_CALLS:-}" ]; then
  printf "%s %s %s\n" "$verb" "$repo" "$root" >> "$FAKE_SOMA_ROOT_CALLS"
fi
key="${repo//\//__}"

# ---- read-only verbs: fixtures ----
case "$verb" in
  frontier|audit|node)
    file=""
    case "$verb" in
      frontier) file="${FAKE_SOMA_DIR}/${key}-frontier.json" ;;
      audit)    file="${FAKE_SOMA_DIR}/${key}-audit.json" ;;
      node)     file="${FAKE_SOMA_DIR}/${key}-node-${root}.json" ;;
    esac
    if [ "$verb" != "node" ] && [ -f "${FAKE_SOMA_DIR}/${key}-${verb}-${root}.json" ]; then
      file="${FAKE_SOMA_DIR}/${key}-${verb}-${root}.json"
    fi
    # The frontier read also audits (node #154). A test with no audit fixture
    # gets a clean audit without buildBriefNotReady — today's installed soma.
    if [ "$verb" = "audit" ] && [ ! -f "$file" ]; then
      printf '{"repo":"%s","root":"%s","nodes":0,"closedWithoutReceipt":[],"openWithoutCheckpoint":[],"openClaimed":[]}\n' "$repo" "$root"
      exit 0
    fi
    if [ ! -f "$file" ]; then
      echo "fake soma: no fixture $file" >&2
      exit 93
    fi
    cat "$file"
    exit 0
    ;;
esac

if [ -z "${FAKE_SOMA_STATE:-}" ]; then
  echo "fake soma: FAKE_SOMA_STATE not set for verb '$verb'" >&2
  exit 94
fi

export FAKE_SOMA_STATE FAKE_SOMA_REPO_DIR FAKE_SOMA_IDENTITY="$identity" \
  FAKE_SOMA_GIST="$gist" FAKE_SOMA_CHECKPOINT="$checkpoint" FAKE_SOMA_RESOLUTION_FILE="${resolution_file:-}" \
  FAKE_SOMA_CI="$ci" FAKE_SOMA_EVIDENCE_FILE="$evidence_file" \
  FAKE_SOMA_PROPOSE="$propose" FAKE_SOMA_BODY_FILE="$body_file" \
  FAKE_SOMA_PROPOSAL_COMMENT="$proposal_comment" \
  FAKE_SOMA_TITLE="$title" FAKE_SOMA_AUTONOMY="$autonomy" FAKE_SOMA_BODY="$body" \
  FAKE_SOMA_PARENT="$parent" FAKE_SOMA_LABELS="$labels" FAKE_SOMA_KIND="$kind" FAKE_SOMA_PROBES="$probes"

# A test can make the map-index write fail the way it did live (node #108).
if [ "$verb" = "decisions" ] && [ -n "${FAKE_SOMA_DECISIONS_FAIL:-}" ]; then
  echo "fake soma: HTTP 504 writing the map index" >&2
  exit 1
fi

# A test can make the close fail with the given text on stderr, closing
# nothing: gh's network error, or a refusal like the probe-tree gate's.
if [ "$verb" = "close" ] && [ -n "${FAKE_SOMA_CLOSE_FAIL:-}" ]; then
  printf '%s\n' "$FAKE_SOMA_CLOSE_FAIL" >&2
  exit 1
fi

# A test can make soma refuse chosen nodes' claims (comma-separated ids, or
# "*" for every claim) the way soma 0.25.0 refuses a blocked node: exit 1 with
# plain text, not JSON, on stderr (node #163).
if [ "$verb" = "claim" ] && [ -n "${FAKE_SOMA_CLAIM_REFUSE:-}" ]; then
  case ",${FAKE_SOMA_CLAIM_REFUSE}," in
    *",${root},"*|",*,")
      echo "Claim refused: node ${root} has an open blocker" >&2
      exit 1
      ;;
  esac
fi

case "$verb" in
  claim|release|close|decisions|add|link)
    python3 - "$verb" "$root" "$repo" <<'PY'
import json, os, subprocess, sys

verb, nid, repo = sys.argv[1], sys.argv[2], sys.argv[3]
state_path = os.environ["FAKE_SOMA_STATE"]
identity = os.environ.get("FAKE_SOMA_IDENTITY", "")

with open(state_path) as fh:
    s = json.load(fh)

def save():
    with open(state_path, "w") as fh:
        json.dump(s, fh, indent=2)

if verb == "add":
    # `graph add <parent>` (node #251): a new issue in state.issues, listed by
    # fake gh's labelled-issue read. FAKE_SOMA_ADD_FAIL=exit fails with no
    # payload; =unattached creates the node and leaves it below no parent.
    fail = os.environ.get("FAKE_SOMA_ADD_FAIL", "")
    if fail == "exit":
        print("fake soma: add failed (HTTP 502)", file=sys.stderr)
        sys.exit(1)
    issues = s.setdefault("issues", {})
    number = s.get("nextIssue", 100)
    s["nextIssue"] = number + 1
    issues[str(number)] = {
        "number": number,
        "parent": nid if fail != "unattached" else None,
        "title": os.environ.get("FAKE_SOMA_TITLE", ""),
        "autonomy": os.environ.get("FAKE_SOMA_AUTONOMY", ""),
        "checkpoint": os.environ.get("FAKE_SOMA_CHECKPOINT", ""),
        "labels": [l for l in os.environ.get("FAKE_SOMA_LABELS", "").split("\n") if l],
        "body": os.environ.get("FAKE_SOMA_BODY", ""),
        "machineAccount": os.environ.get("GH_TOKEN", "") == "ghp_write",
    }
    # Kind and probes (node #252) are recorded only when the add passed them.
    if os.environ.get("FAKE_SOMA_KIND", ""):
        issues[str(number)]["kind"] = os.environ["FAKE_SOMA_KIND"]
    probes = [json.loads(p) for p in os.environ.get("FAKE_SOMA_PROBES", "").split("\n") if p]
    if probes:
        issues[str(number)]["probes"] = probes
    save()
    if fail == "unattached":
        print(json.dumps({"repo": repo, "node": str(number), "parent": nid, "attached": False}), file=sys.stderr)
        sys.exit(1)
    print(json.dumps({"repo": repo, "node": str(number), "parent": nid, "attached": True}))
    sys.exit(0)

if verb == "link":
    # FAKE_SOMA_LINK_FAIL=exit fails the attach (node #251's unattached repair).
    if os.environ.get("FAKE_SOMA_LINK_FAIL", "") == "exit":
        print("fake soma: link failed (HTTP 502)", file=sys.stderr)
        sys.exit(1)
    issue = s.setdefault("issues", {}).get(nid)
    if issue is None:
        print(f"fake soma: no node {nid}", file=sys.stderr)
        sys.exit(1)
    parent = os.environ.get("FAKE_SOMA_PARENT", "")
    status = "already" if issue.get("parent") == parent else "attached"
    issue["parent"] = parent
    s.setdefault("links", []).append({"node": nid, "parent": parent})
    save()
    print(json.dumps({"repo": repo, "node": nid, "parent": parent, "parentStatus": status}))
    sys.exit(0)

nodes = s.setdefault("nodes", {})
node = nodes.setdefault(nid, {"assignees": [], "status": "open", "probes": []})

if verb == "claim":
    if node.get("assignees"):
        holder = node["assignees"][0]
        payload = {"repo": repo, "node": nid, "held": False, "holder": holder, "assignees": node["assignees"]}
        print(json.dumps(payload), file=sys.stderr)
        sys.exit(1)
    node["assignees"] = [identity]
    save()
    payload = {"repo": repo, "node": nid, "held": True, "holder": identity, "assignees": [identity]}
    print(json.dumps(payload))
    sys.exit(0)

if verb == "release":
    if identity in node.get("assignees", []):
        node["assignees"] = [a for a in node["assignees"] if a != identity]
        save()
        print(json.dumps({"repo": repo, "node": nid, "released": True, "assignees": node["assignees"]}))
    else:
        print(json.dumps({"repo": repo, "node": nid, "released": False, "assignees": node.get("assignees", [])}))
    sys.exit(0)

if verb == "close" and os.environ.get("FAKE_SOMA_PROPOSE") == "1":
    # `close --propose` (node #246): posts the body as a proposal comment and
    # closes nothing. Faithful to soma: no --resolution-file beside it.
    if os.environ.get("FAKE_SOMA_RESOLUTION_FILE", ""):
        print("soma graph close --propose cannot be combined with --resolution-file: the proposal body is the resolution.", file=sys.stderr)
        sys.exit(1)
    with open(os.environ.get("FAKE_SOMA_BODY_FILE", "")) as fh:
        body = fh.read()
    proposals = s.setdefault("proposals", [])
    cid = 9001 + len(proposals)
    proposals.append({"node": nid, "body": body, "identity": identity, "commentId": cid, "cwd": os.getcwd()})
    save()
    url = f"https://github.com/{repo}/issues/{nid}#issuecomment-{cid}"
    # FAKE_SOMA_PROPOSE_OUTPUT: text (soma today), json (ruling D18), garbled (no id).
    mode = os.environ.get("FAKE_SOMA_PROPOSE_OUTPUT", "text")
    if mode == "json":
        print(json.dumps({"repo": repo, "node": nid, "commentId": cid + 100, "url": url.replace(str(cid), str(cid + 100))}))
    elif mode == "garbled":
        print("Proposal posted.")
    else:
        print(f"Posted proposal comment {cid} on node {nid} ({repo}).")
        print(f"url: {url}")
        print("")
        print("The receipt is a thumbs-up on THIS comment from the graph root's author.")
    sys.exit(0)

if verb == "close":
    resolution_file = os.environ.get("FAKE_SOMA_RESOLUTION_FILE", "")
    proposal_comment = os.environ.get("FAKE_SOMA_PROPOSAL_COMMENT", "")
    # Faithful to soma: a close naming --proposal-comment reuses that body as
    # the resolution, so it needs no --resolution-file.
    if not proposal_comment and (not resolution_file or not os.path.isfile(resolution_file)):
        print(f"fake soma: close --resolution-file {resolution_file} not readable", file=sys.stderr)
        sys.exit(1)
    proposal_evidence = []
    if proposal_comment:
        # Faithful to soma (cli/graph.ts): the comment's reactions (every page of
        # state.reactions[id]); a root-author 👎 refuses; a 👍 from anyone but
        # the proposer is the `approved` evidence, the root author's preferred.
        # Soma pins nothing else.
        pages = s.get("reactions", {}).get(proposal_comment, [])
        reactions = [r for page in pages for r in page]
        proposer = next((p["identity"] for p in s.get("proposals", []) if str(p["commentId"]) == proposal_comment), "")
        root_author = s.get("rootAuthor", "jcfischer")
        if any(r["content"] == "-1" and r["user"]["login"] == root_author for r in reactions):
            print(f"Node {nid} was refused: {root_author} left a 👎 on proposal comment {proposal_comment}.", file=sys.stderr)
            sys.exit(1)
        approvals = sorted(r["user"]["login"] for r in reactions if r["content"] == "+1" and r["user"]["login"] != proposer)
        ratifier = root_author if root_author in approvals else (approvals[0] if approvals else None)
        if ratifier is not None:
            proposal_evidence.append({
                "kind": "approved",
                "summary": f"ratified by {ratifier} via thumbs-up on proposal comment {proposal_comment}",
                "pointer": f"https://github.com/{repo}/issues/{nid}#issuecomment-{proposal_comment}",
            })
    bare = os.environ.get("FAKE_SOMA_REPO_DIR", "")
    # Faithful to the real gate (DD-16 Amendment A containment): an ungated
    # git-ref-exists probe resolves against the close runner's cwd — the probe
    # tree is bounded to that tree. The findings branch lives in the canonical
    # checkout (a linked worktree's branch is a ref there), so the close must
    # run FROM the canonical checkout. Record the cwd so the test can assert it.
    probe_cwd = os.getcwd()
    s["lastCloseCwd"] = probe_cwd
    ci = os.environ.get("FAKE_SOMA_CI", "")
    with open(os.environ["FAKE_SOMA_EVIDENCE_FILE"]) as fh:
        evidence = [json.loads(line) for line in fh if line.strip()] + proposal_evidence
    s["lastClose"] = {"ci": ci, "evidence": evidence, "checkpoint": os.environ.get("FAKE_SOMA_CHECKPOINT", ""),
                      "proposalComment": proposal_comment, "resolutionFile": resolution_file}
    # Faithful to the installed gate: an auto node must cite a CI check run.
    if node.get("autonomy") == "auto" and not ci:
        print(f"Close refused: node {nid} (auto) must cite a successful CI check run (checkRunId and headSha) to close", file=sys.stderr)
        save()
        sys.exit(1)
    for probe in node.get("probes", []):
        if probe.get("type") == "git-ref-exists" and probe.get("ref"):
            ref = probe["ref"]
            ok = subprocess.run(
                ["git", "-C", probe_cwd, "rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}"],
                capture_output=True,
            ).returncode == 0
            if not ok:
                save()
                print(f"Close refused for node {nid}: probe git-ref-exists '{ref}' failed — {ref} does not resolve in {probe_cwd}.", file=sys.stderr)
                sys.exit(1)
        if probe.get("type") == "artifact-exists" and probe.get("atRef"):
            spec = f"{probe['atRef']}:{probe['path']}"
            ok = subprocess.run(["git", "-C", probe_cwd, "cat-file", "-e", spec], capture_output=True).returncode == 0
            if not ok:
                save()
                print(f"Close refused for node {nid}: probe artifact-exists {spec} failed in {probe_cwd}.", file=sys.stderr)
                sys.exit(1)
    node["status"] = "closed"
    s.setdefault("decisions", []).append({
        "id": nid,
        "gist": os.environ.get("FAKE_SOMA_GIST", ""),
        "closedBy": identity,
    })
    save()
    print(f"Closed node {nid} ({repo}) — attestation: unverified.")
    print("")
    print("Receipt posted to the tracker.")
    print(f"gist: {os.environ.get('FAKE_SOMA_GIST','')}")
    print(f"closedBy: {identity}")
    sys.exit(0)

if verb == "decisions":
    count = len(s.get("decisions", []))
    print(f"Wrote {count} decision line(s) into map {nid} ({repo}).")
    sys.exit(0)
PY
    exit $?
    ;;
  *)
    echo "fake soma: verb '$verb' is not on the read-only surface" >&2
    exit 92
    ;;
esac
