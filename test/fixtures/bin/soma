#!/usr/bin/env bash
# Fake `soma` for tests.
#
# Reads (frontier/audit/node) come from fixture JSON in $FAKE_SOMA_DIR. Mutations
# (claim/release/close/decisions) are stateful against $FAKE_SOMA_STATE (JSON),
# and `close` verifies git-ref-exists probes against the real git repo at
# $FAKE_SOMA_REPO_DIR (a bare origin, so a pushed branch shows up directly).
set -euo pipefail

if [ -z "${GH_TOKEN:-}" ]; then
  echo "fake soma: GH_TOKEN not set — refusing (no keyring fallback)" >&2
  exit 90
fi
if [ -z "${FAKE_SOMA_DIR:-}" ]; then
  echo "fake soma: FAKE_SOMA_DIR not set" >&2
  exit 91
fi

verb="${2:-}"
root="${3:-}"
repo=""
json_flag=""
identity=""
resolution_file=""
gist=""
checkpoint=""
ci=""
evidence_file="$(mktemp)"
i=4
while [ $i -le $# ]; do
  arg="${!i}"
  case "$arg" in
    --repo) i=$((i+1)); repo="${!i}" ;;
    --json) json_flag=1 ;;
    --identity) i=$((i+1)); identity="${!i}" ;;
    --resolution-file) i=$((i+1)); resolution_file="${!i}" ;;
    --gist) i=$((i+1)); gist="${!i}" ;;
    --checkpoint) i=$((i+1)); checkpoint="${!i}" ;;
    --ci) i=$((i+1)); ci="${!i}" ;;
    --evidence) i=$((i+1)); printf "%s\n" "${!i}" >> "$evidence_file" ;;
    --write) : ;;
    --dry-run) : ;;
  esac
  i=$((i+1))
done

# Real soma resolves a bare owner/name only from a checkout with an origin
# remote, and launchd runs ranger from `/` (2026-09-25 outage). The fake is
# stricter than soma: it refuses a bare repo wherever it runs, so a call site
# that forgets to qualify fails here instead of only in production.
case "$repo" in
  github:github.com/*) repo="${repo#github:github.com/}" ;;
  "") ;;
  *)
    echo "fake soma: \"$repo\" names no forge or host — pass --repo github:github.com/<owner/name>" >&2
    exit 2
    ;;
esac
# Every invocation is logged (verb + bare repo) when the test asks, so a test
# can count graph reads — the cache (src/frontier-cache.ts) is judged by it.
if [ -n "${FAKE_SOMA_CALLS:-}" ]; then
  printf "%s %s\n" "$verb" "$repo" >> "$FAKE_SOMA_CALLS"
fi
# A test can make the read verbs fail as GitHub's throttle does.
if [ -n "${FAKE_SOMA_RATE_LIMITED:-}" ]; then
  case "$verb" in
    frontier|audit|node)
      echo "gh api POST graphql failed (exit 1): gh: API rate limit already exceeded for user ID 1." >&2
      exit 1
      ;;
  esac
fi

if [ -n "${FAKE_SOMA_ROOT_CALLS:-}" ]; then
  printf "%s %s %s\n" "$verb" "$repo" "$root" >> "$FAKE_SOMA_ROOT_CALLS"
fi
key="${repo//\//__}"

# ---- read-only verbs: fixtures ----
case "$verb" in
  frontier|audit|node)
    file=""
    case "$verb" in
      frontier) file="${FAKE_SOMA_DIR}/${key}-frontier.json" ;;
      audit)    file="${FAKE_SOMA_DIR}/${key}-audit.json" ;;
      node)     file="${FAKE_SOMA_DIR}/${key}-node-${root}.json" ;;
    esac
    if [ "$verb" != "node" ] && [ -f "${FAKE_SOMA_DIR}/${key}-${verb}-${root}.json" ]; then
      file="${FAKE_SOMA_DIR}/${key}-${verb}-${root}.json"
    fi
    if [ ! -f "$file" ]; then
      echo "fake soma: no fixture $file" >&2
      exit 93
    fi
    cat "$file"
    exit 0
    ;;
esac

if [ -z "${FAKE_SOMA_STATE:-}" ]; then
  echo "fake soma: FAKE_SOMA_STATE not set for verb '$verb'" >&2
  exit 94
fi

export FAKE_SOMA_STATE FAKE_SOMA_REPO_DIR FAKE_SOMA_IDENTITY="$identity" \
  FAKE_SOMA_GIST="$gist" FAKE_SOMA_CHECKPOINT="$checkpoint" FAKE_SOMA_RESOLUTION_FILE="${resolution_file:-}" \
  FAKE_SOMA_CI="$ci" FAKE_SOMA_EVIDENCE_FILE="$evidence_file"

case "$verb" in
  claim|release|close|decisions)
    python3 - "$verb" "$root" "$repo" <<'PY'
import json, os, subprocess, sys

verb, nid, repo = sys.argv[1], sys.argv[2], sys.argv[3]
state_path = os.environ["FAKE_SOMA_STATE"]
identity = os.environ.get("FAKE_SOMA_IDENTITY", "")

with open(state_path) as fh:
    s = json.load(fh)
nodes = s.setdefault("nodes", {})
node = nodes.setdefault(nid, {"assignees": [], "status": "open", "probes": []})

def save():
    with open(state_path, "w") as fh:
        json.dump(s, fh, indent=2)

if verb == "claim":
    if node.get("assignees"):
        holder = node["assignees"][0]
        payload = {"repo": repo, "node": nid, "held": False, "holder": holder, "assignees": node["assignees"]}
        print(json.dumps(payload), file=sys.stderr)
        sys.exit(1)
    node["assignees"] = [identity]
    save()
    payload = {"repo": repo, "node": nid, "held": True, "holder": identity, "assignees": [identity]}
    print(json.dumps(payload))
    sys.exit(0)

if verb == "release":
    if identity in node.get("assignees", []):
        node["assignees"] = [a for a in node["assignees"] if a != identity]
        save()
        print(json.dumps({"repo": repo, "node": nid, "released": True, "assignees": node["assignees"]}))
    else:
        print(json.dumps({"repo": repo, "node": nid, "released": False, "assignees": node.get("assignees", [])}))
    sys.exit(0)

if verb == "close":
    resolution_file = os.environ.get("FAKE_SOMA_RESOLUTION_FILE", "")
    if not resolution_file or not os.path.isfile(resolution_file):
        print(f"fake soma: close --resolution-file {resolution_file} not readable", file=sys.stderr)
        sys.exit(1)
    bare = os.environ.get("FAKE_SOMA_REPO_DIR", "")
    # Faithful to the real gate (DD-16 Amendment A containment): an ungated
    # git-ref-exists probe resolves against the close runner's cwd — the probe
    # tree is bounded to that tree. The findings branch lives in the canonical
    # checkout (a linked worktree's branch is a ref there), so the close must
    # run FROM the canonical checkout. Record the cwd so the test can assert it.
    probe_cwd = os.getcwd()
    s["lastCloseCwd"] = probe_cwd
    ci = os.environ.get("FAKE_SOMA_CI", "")
    with open(os.environ["FAKE_SOMA_EVIDENCE_FILE"]) as fh:
        evidence = [json.loads(line) for line in fh if line.strip()]
    s["lastClose"] = {"ci": ci, "evidence": evidence, "checkpoint": os.environ.get("FAKE_SOMA_CHECKPOINT", "")}
    # Faithful to the installed gate: an auto node must cite a CI check run.
    if node.get("autonomy") == "auto" and not ci:
        print(f"Close refused: node {nid} (auto) must cite a successful CI check run (checkRunId and headSha) to close", file=sys.stderr)
        save()
        sys.exit(1)
    for probe in node.get("probes", []):
        if probe.get("type") == "git-ref-exists" and probe.get("ref"):
            ref = probe["ref"]
            ok = subprocess.run(
                ["git", "-C", probe_cwd, "rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}"],
                capture_output=True,
            ).returncode == 0
            if not ok:
                save()
                print(f"Close refused for node {nid}: probe git-ref-exists '{ref}' failed — {ref} does not resolve in {probe_cwd}.", file=sys.stderr)
                sys.exit(1)
        if probe.get("type") == "artifact-exists" and probe.get("atRef"):
            spec = f"{probe['atRef']}:{probe['path']}"
            ok = subprocess.run(["git", "-C", probe_cwd, "cat-file", "-e", spec], capture_output=True).returncode == 0
            if not ok:
                save()
                print(f"Close refused for node {nid}: probe artifact-exists {spec} failed in {probe_cwd}.", file=sys.stderr)
                sys.exit(1)
    node["status"] = "closed"
    s.setdefault("decisions", []).append({
        "id": nid,
        "gist": os.environ.get("FAKE_SOMA_GIST", ""),
        "closedBy": identity,
    })
    save()
    print(f"Closed node {nid} ({repo}) — attestation: unverified.")
    print("")
    print("Receipt posted to the tracker.")
    print(f"gist: {os.environ.get('FAKE_SOMA_GIST','')}")
    print(f"closedBy: {identity}")
    sys.exit(0)

if verb == "decisions":
    count = len(s.get("decisions", []))
    print(f"Wrote {count} decision line(s) into map {nid} ({repo}).")
    sys.exit(0)
PY
    exit $?
    ;;
  *)
    echo "fake soma: verb '$verb' is not on the read-only surface" >&2
    exit 92
    ;;
esac
